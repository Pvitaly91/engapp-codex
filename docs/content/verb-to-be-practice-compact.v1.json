          },
          {
            "index": 1,
            "source_item_sha256": "213373a13d15b3b23f7024db2fee15b27c433ffbd005878b38d89d605612f87f",
            "instruction_uk": "Запитай про місце Олени вчора; потрібне пряме питання з be.",
            "stimuli": [
              {
                "lang": "en",
                "text": "____ Olena at the station yesterday?"
              }
            ]
          },
          {
            "index": 2,
            "source_item_sha256": "c1a9f18ff960e3b4ca56dfde3d3f070209fe9eb58129b1b239e5348d97e9b6fe",
            "instruction_uk": "Передай минулий стан запізнення одного порома.",
            "stimuli": [
              {
                "lang": "en",
                "text": "The ferry ____ late yesterday."
              }
            ]
          },
          {
            "index": 3,
            "source_item_sha256": "89a596bea777df31bd89a9469ce40a97f942132421e218825f1c11d5aa2553fa",
            "instruction_uk": "У понеділок магазини були зачинені. Узгодь минулу форму з множиною.",
            "stimuli": [
              {
                "lang": "en",
                "text": "The shops ____ closed on Monday."
              }
            ]
          }
        ],
        "choices": [
          {
            "index": 0,
            "source_item_sha256": "a8e48c803f5bc1426a11af5a6076c9cab8ed9a99f8da43a285647026a523ee07",
            "instruction_uk": "Відомо лише це повідомлення; про сьогодні нічого не сказано. Обери правильний висновок.",
            "stimuli": [
              {
                "lang": "en",
                "text": "Marta was busy yesterday."
              }
            ]
          },
          {
            "index": 1,
            "source_item_sha256": "23cb48eb0150d631e6aa71cd576b9794f368dc7cf7bb32c392f2c572cb9410c8",
            "instruction_uk": "Батько питає двох дітей про вчорашній ранок. Одна відповідає від обох. Про кого й коли йдеться?",
            "stimuli": [
              {
                "lang": "en",
                "text": "Were you tired? — Yes, we were."
              }
            ]
          }
        ],
        "inputs": [
          {
            "index": 0,
            "source_item_sha256": "877ae626f6a89abff79fdca6f7ac16d40dd1e607ca78d7c19a7e9161f35329fd",
            "instruction_uk": "Почни з Olena and I; музей уже згаданий, місце постав перед часом.",
            "stimuli": [
              {
                "lang": "uk",
                "text": "Ми з Оленою були в музеї вчора."
              }
            ]
          },
          {
            "index": 1,
            "source_item_sha256": "b67db3f72c2a2b42c1c299e3834c2e80d68ed86f86afc87bce6f0575470b5cfd",
            "instruction_uk": "Почни з відомої бібліотеки; запереч її відкритість, час залиш наприкінці.",
            "stimuli": [
              {
                "lang": "uk",
                "text": "Бібліотека не була відчинена вчора."
              }
            ]
          },
          {
            "index": 2,
            "source_item_sha256": "a18e310004414466252cbf65f8772830c5d5271c16e5a6d277d1c2e008f1da7c",
            "instruction_uk": "Почни з уже відомих вулиць; час залиш наприкінці.",
            "stimuli": [
              {
                "lang": "uk",
                "text": "Минулої ночі вулиці були тихі."
              }
            ]
          },
          {
            "index": 3,
            "source_item_sha256": "be3e684019c4478d7f7992615c72e6cfafb4b47da73a537f07fe7ed73e33fbb5",
            "instruction_uk": "Почни з I; назви місце відвідування, потім день.",
            "stimuli": [
              {
                "lang": "uk",
                "text": "У вівторок я був у стоматолога."
              }
            ]
          }
