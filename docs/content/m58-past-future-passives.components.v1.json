      "uuid": "3ac79c13-3e39-5c81-a08c-c833d9ee64cf",
      "detail_owners": [
        {
          "key": "past-perfect-before-noncompletion",
          "title": "Before + Perfect не завжди стверджує завершення",
          "owner_block_key": "past-perfect-affirmative",
          "owner_pointer": "/sections/0",
          "fragment": {
            "type": "usage-panels",
            "data": {
              "sections": [
                {
                  "label": "ЯКУ ЧАСТИНУ РЕЧЕННЯ ЗАПЕРЕЧУЄ КОНТЕКСТ",
                  "color": "slate",
                  "description": "У першому прикладі до відходу гостей вечерю вже подали. У другому гості йдуть раніше за завершення подачі вечері. Perfect усередині before-частини не доводить, що вся вечеря справді була подана: цей етап ще не настав до відходу гостей. Що сталося пізніше, треба з’ясовувати з продовження.",
                  "examples": [
                    {
                      "en": "Dinner had been served before the guests left.",
                      "ua": "Вечерю вже подали до того, як гості пішли."
                    },
                    {
                      "en": "The guests left before dinner had been fully served.",
                      "ua": "Гості пішли, не дочекавшись, поки вечерю подадуть повністю."
                    }
                  ],
                  "note": "Не застосовуй правило «had been + V3 завжди означає фактично завершену дію» без читання цілого речення."
                }
              ]
            }
          }
        }
      ],
      "basic": "Повні підтримані data fields видимі, крім явно прив’язаних meaningful detail fragments; feedback практики — після Check."
    },
    {
      "identity": "Database\\Seeders\\Page_V3\\PassiveVoice\\Tenses\\PassiveVoicePastPerfectTheorySeeder",
      "key": "past-perfect-uses",
      "source_index": 3,
      "type": "usage-panels",
      "column": "left",
      "level": "B1",
      "body_sha256": "5e0a8d985c404bbff85272364acc4eed4747cf8f0cc5bad295c442e2a4483bad",
      "body_bytes": 3142,
      "uuid": "74c1bfbb-2370-5585-a6a7-3d9adc5070cb",
      "detail_owners": [
        {
          "key": "past-perfect-before-perspective",
          "title": "Чому before не вимагає Perfect",
          "owner_block_key": "past-perfect-uses",
          "owner_pointer": "/sections/0",
          "fragment": {
            "type": "usage-panels",
            "data": {
              "sections": [
                {
                  "label": "ПОРЯДОК ПОДІЙ І ПОГЛЯД НАЗАД",
                  "color": "slate",
                  "description": "У двох реченнях прибирання передує приїзду: цю послідовність уже задає before. Past Simple розповідає про подію; Past Perfect виразніше відраховує попереднє від минулого моменту приїзду. Тому речення з was cleaned не можна оголосити неправильним лише через before. У вправі на одну конкретну форму її має прямо задавати умова.",
                  "examples": [
                    {
                      "en": "The room was cleaned before I arrived.",
                      "ua": "Кімнату прибрали до мого приїзду."
                    },
                    {
                      "en": "The room had been cleaned before I arrived.",
                      "ua": "До мого приїзду кімнату вже прибрали."
                    }
                  ],
                  "note": "Perfect не є окремим способом сказати «дуже давно»: точка відліку може бути й учорашньою."
                }
              ]
            }
          }
        }
      ],
      "basic": "Повні підтримані data fields видимі, крім явно прив’язаних meaningful detail fragments; feedback практики — після Check."
    },
