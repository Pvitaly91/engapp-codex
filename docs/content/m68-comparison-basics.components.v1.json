    {
      "identity": "Database\\Seeders\\Page_V3\\Adjectives\\AdjectivesComparativeVsSuperlativeTheorySeeder",
      "source_index": 7,
      "key": "comparative-special",
      "type": "usage-panels",
      "level": "B2",
      "body_sha256": "265a040d086271d27707c55247308c80da46869f857041830a3c07616ccbf9dd",
      "uuid": "668cc0a5-7d67-5d96-97ff-b6bdfa5d42b6",
      "native_view": "engram.theory.blocks-v3.usage-panels",
      "detail_owners": [
        {
          "key": "comparative-evaluation-not-ranking",
          "owner_block_key": "comparative-special",
          "owner_pointer": "/sections/2",
          "title": "Оцінка мовця не завжди є виміряним рейтингом",
          "editorial_decision": "Meaningful separate worked contrast. Visible basic already distinguishes best and formal very-most; this detail adds contextual grounds and prevents unsupported ranking inferences.",
          "fragment": {
            "type": "usage-panels",
            "data": {
              "sections": [
                {
                  "label": "Подяка, сильна оцінка та порівняння всього набору",
                  "color": "slate",
                  "description": "У першій ситуації людина дякує за допомогу, а не звітує про вимірювання здібностей усіх людей. Best залишається superlative, але неозвучена група й емоційний намір не дають підстав придумати всесвітній рейтинг. У другій ситуації a most enjoyable характеризує вечір як дуже приємний у формальному стилі. Воно не повідомляє, що цей вечір перевершив кожний інший; заміна на the most enjoyable змінила б конструкцію та додала порівняльний обсяг, який треба встановити контекстом.",
                  "examples": [
                    {
                      "en": "You found my keys. You are the best!",
                      "ua": "Ти знайшов мої ключі. Ти найкращий!"
                    },
                    {
                      "en": "We had a most enjoyable evening, and we would like to thank our hosts.",
                      "ua": "Ми провели дуже приємний вечір і хотіли б подякувати господарям."
                    }
                  ],
                  "note": "Вислів може бути щирою оцінкою без числової шкали. Для оцінюваного завдання про найвищий бал або найменшу довжину натомість потрібні визначена група й достатні факти."
                }
              ]
            }
          }
        }
      ],
      "semantic_component": "usage-panels",
      "column": "right",
      "canonical_entry": "theory.content"
    },
