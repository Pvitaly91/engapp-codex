ості. Якщо ознак багато, можна розподілити опис на кілька речень, але це редакторська порада: вона не дозволяє викинути потрібну ознаку під час виправлення."}]}}}],"native_view":"engram.theory.blocks-v3.usage-panels","semantic_component":"usage-panels","canonical_entry":"theory.content"},{"identity":"Database\\Seeders\\Page_V3\\Adjectives\\AdjectivesOrderOfAdjectivesTheorySeeder","source_index":3,"key":"order-mistakes","type":"mistakes-grid","column":"right","level":"B1","continuing":true,"uuid":"9b786734-90b5-5968-be58-ae76920b4029","body_sha256":"d03f26b4534a392ced243b659fc3e168cc00e4a435cc5e832c0c27bb598909d7","detail_owners":[],"native_view":"engram.theory.blocks-v3.mistakes-grid","semantic_component":"mistakes-grid","canonical_entry":"theory.content"},{"identity":"Database\\Seeders\\Page_V3\\Adjectives\\AdjectivesOrderOfAdjectivesTheorySeeder","source_index":4,"key":"order-summary","type":"summary-list","column":"right","level":"B1","continuing":true,"uuid":"affab885-27b0-5325-b782-198598dabfa0","body_sha256":"86156c0f17267f5ba4e177d71a7faa3a5bce86e2137737dfcd6c26cf95880ca9","detail_owners":[],"native_view":"engram.theory.blocks-v3.summary-list","semantic_component":"summary-list","canonical_entry":"theory.content"},{"identity":"Database\\Seeders\\Page_V3\\Adjectives\\AdjectivesOrderOfAdjectivesTheorySeeder","source_index":5,"key":"order-navigation","type":"navigation-chips","column":"footer","level":null,"continuing":true,"uuid":"20f289d8-1ee7-554d-bac0-0f2a7e6d19db","body_sha256":"3c36cdee77facbbf39ca2e51405bae8b85b89c70fb700aff32646c70d9749810","detail_owners":[],"native_view":null,"semantic_component":"navigation-chips","canonical_entry":null},{"identity":"Database\\Seeders\\Page_V3\\Adjectives\\AdjectivesOrderOfAdjectivesTheorySeeder","source_index":6,"key":"order-practice","type":"practice-set","column":"left","level":"B1","continuing":false,"uuid":"d0e8085e-a95d-5ec5-8d93-5acd760cf895","body_sha256":"b6e3a124934010f9d31e5c160128834f4a6b94ef2bd7ca62333d7c