                        ]
                    },
                    {
                        "index": 1,
                        "source_item_sha256": "39fa5a2f5f5e9606d4471b071e0e4e01f69bdd680fa89741c066214589fef504",
                        "instruction_uk": "Назви щось цікаве без іменника; прикметник має стояти після займенника.",
                        "stimuli": [
                            {
                                "lang": "en",
                                "text": "I would like ____ to read."
                            }
                        ]
                    }
                ],
                "choices": [
                    {
                        "index": 0,
                        "source_item_sha256": "4327923f2c6b8807d2d8e0dfb4cbb69df1577fc3ef7294b0fd164c91693a9983",
                        "instruction_uk": "Куртка й парасоля зараз не потрібні, а зошит потрібний. Обери висновок про цю частину списку.",
                        "stimuli": [
                            {
                                "lang": "en",
                                "text": "I do not need some things now."
                            },
                            {
                                "lang": "uk",
                                "text": "a: Можна без зміни змісту сказати, що не потрібно нічого."
                            },
                            {
                                "lang": "uk",
                                "text": "b: Частина речей не потрібна, але інша річ потрібна."
                            },
                            {
                                "lang": "uk",
                                "text": "c: Будь-яке слово some у запереченні неграматичне."
