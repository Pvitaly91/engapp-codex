            "items": {
                "selects": [
                    {
                        "index": 0,
                        "source_item_sha256": "303c57fa96f385678124c1fb022715676dbebcff55e20ad61bc103b1d97fda47",
                        "instruction_uk": "Обери слово для одного заперечного змісту: ключі не знайдено в жодному перевіреному місці.",
                        "stimuli": [
                            {
                                "lang": "en",
                                "text": "I can’t find my keys ____."
                            }
                        ]
                    },
                    {
                        "index": 1,
                        "source_item_sha256": "440dfde51589708d043feb4bfd09d47dd6162ad80daf8763255903ceafeaf8c9",
                        "instruction_uk": "Назви одне невизначене місце біля моря, не всі місця й не необмежений вільний вибір.",
                        "stimuli": [
                            {
                                "lang": "en",
                                "text": "She wants to live ____ near the sea."
                            }
                        ]
                    },
                    {
                        "index": 2,
                        "source_item_sha256": "37d81e4d45541265f081181d56e7090ddc465c28500b351e2eb31de97fd188ff",
                        "instruction_uk": "Доповни запрошення кудись піти: мовець очікує згоди, а не ставить нейтральне запитання.",
                        "stimuli": [
                            {
                                "lang": "en",
                                "text": "Do you want to go ____ this evening?"
                            }
                        ]
                    }
                ],
                "choices": [
                    {
                        "index": 0,
                        "source_item_sha256": "c7e31a6697095510d1eb5f502b0343422d2bf9c4bb3b170afc51654c4065abe8",
                        "instruction_uk": "У читальній залі всі місця дозволені. Що означає цей дозвіл?",
                        "stimuli": [
                            {
                                "lang": "en",
                                "text": "You can sit anywhere in this room."
                            }
                        ]
                    },
                    {
                        "index": 1,
                        "source_item_sha256": "20dea58c3b0d7da88454d6462ce23cbd039cae7bf0ca6b6711f5b75c226fe17c",
                        "instruction_uk": "Працівник говорить лише про найближчі вулиці. Обери висновок, що зберігає це обмеження.",
                        "stimuli": [
                            {
                                "lang": "en",
                                "text": "There is nowhere to eat near here."
                            }
                        ]
                    }
                ],
                "inputs": [
                    {
                        "index": 0,
                        "source_item_sha256": "30f44ad289fe7a3c9efc8c773098f394ae247ce1dc766261cb6b3ff49e30cb11",
                        "instruction_uk": "Уведи лише слово місця: заперечення вже наведене.",
                        "stimuli": [
                            {
                                "lang": "en",
                                "text": "I don’t want to go ____ tonight."
                            },
                            {
                                "lang": "uk",
                                "text": "Сьогодні ввечері я не хочу нікуди йти."
                            }
                        ]
                    },
                    {
                        "index": 1,
                        "source_item_sha256": "ceb1c4db7181fc76cc18da666213f24b53454a3612f77047e23d7e48e3b0263a",
                        "instruction_uk": "Уведи лише слово місця: усі місця для сидіння зайняті.",
                        "stimuli": [
                            {
                                "lang": "en",
                                "text": "There is ____ to sit in this park. Every seat is occupied."
                            },
                            {
                                "lang": "uk",
                                "text": "У цьому парку ніде сісти."
                            }
                        ]
                    },
                    {
                        "index": 2,
                        "source_item_sha256": "4f38576c9c5ed7d9214187ba0da9400cc13e25064e93d710e5cfd06a077ee187",
                        "instruction_uk": "Уведи одне слово, яке охоплює всі міста зі згаданого списку.",
                        "stimuli": [
                            {
                                "lang": "en",
                                "text": "He travels ____ for work."
                            },
                            {
                                "lang": "uk",
                                "text": "Він їздить усюди у справах."
                            }
                        ]
                    },
                    {
                        "index": 3,
                        "source_item_sha256": "7099560d55c423a54824a36550d5664be9b26d46c99de9f4ba50f99695133b83",
                        "instruction_uk": "Склади речення про вільний вибір місця зустрічі лише в цьому парку.",
                        "stimuli": [
                            {
                                "lang": "uk",
                                "text": "Ми можемо зустрітися будь-де в цьому парку."
                            }
                        ]
                    },
                    {
                        "index": 4,
                        "source_item_sha256": "25c18b6219ec00ed4a654823e30b024f2992acf3da3f4fe343fe2a35e627d44f",
                        "instruction_uk": "Почни з конструкції наявності; місця для паркування немає саме біля вокзалу.",
                        "stimuli": [
                            {
                                "lang": "uk",
                                "text": "Біля вокзалу ніде припаркуватися."
                            }
                        ]
                    },
                    {
                        "index": 5,
                        "source_item_sha256": "f553bbf920bf06e9737473c4e7d3434b1daed9c0fcbd4d515e53f92197a69825",
                        "instruction_uk": "Почни з конструкції наявності; після слова місця постав ознаку тиші.",
                        "stimuli": [
                            {
                                "lang": "uk",
                                "text": "Біля озера є десь тихе місце."
                            }
                        ]
                    },
                    {
                        "index": 6,
                        "source_item_sha256": "16938e8f5e8fc1b7362f3fb934442bf1f0f4b01849599772641361234d78f26b",
                        "instruction_uk": "Передай дозвіл залишити сумку та вільний вибір місця в цій кімнаті.",
                        "stimuli": [
                            {
                                "lang": "uk",
                                "text": "Ти можеш залишити свою сумку будь-де в цій кімнаті."
                            }
                        ]
                    }
                ],
                "rephrase": [
                    {
                        "index": 0,
                        "source_item_sha256": "b84d8953b325558d3547af6b9c2756326297bb751ec50d8067dfa610f710b57b",
                        "instruction_uk": "Зразок перетворення зі збереженням змісту.",
                        "stimuli": [
                            {
                                "lang": "en",
                                "text": "I don’t go anywhere on Saturdays."
                            },
                            {
                                "lang": "en",
                                "text": "→ I go nowhere on Saturdays."
                            },
                            {
                                "lang": "uk",
                                "text": "Я нікуди не ходжу по суботах."
                            }
                        ]
                    },
                    {
                        "index": 1,
                        "source_item_sha256": "8013cf446e235921ba562a5fcb77d5765d8d8102eb64eb7aee6fd8f775de9c45",
                        "instruction_uk": "Збережи зміст, особу й час; використай заперечне допоміжне дієслово та слово місця без другого заперечення.",
                        "stimuli": [
                            {
                                "lang": "en",
                                "text": "I go nowhere on Friday evenings."
                            },
                            {
                                "lang": "uk",
                                "text": "Я нікуди не ходжу у п’ятницю ввечері."
                            }
                        ]
                    },
                    {
                        "index": 2,
                        "source_item_sha256": "4e4caf8078a9a07cb11ca52d3099b28499c7edb5a2fac60b0781611d1e5608d4",
                        "instruction_uk": "Збережи зміст, особу й телефон; передай заперечення одним словом місця без заперечного допоміжного дієслова.",
                        "stimuli": [
                            {
                                "lang": "en",
                                "text": "She doesn’t go anywhere without her phone."
                            },
                            {
                                "lang": "uk",
                                "text": "Вона нікуди не ходить без свого телефона."
                            }
                        ]
                    }
                ]
            },
