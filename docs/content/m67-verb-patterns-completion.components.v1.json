      "detail_owners": [
        {
          "key": "meaning-memory-evidence",
          "owner_block_key": "meaning-usage",
          "owner_pointer": "/sections/1",
          "title": "Відсутність спогаду ще не доводить пропуску дії",
          "editorial_decision": "Meaningful worked memory/evidence comparison; core remember/forget contrasts, question status and translations remain in visible basic.",
          "fragment": {
            "type": "usage-panels",
            "data": {
              "sections": [
                {
                  "label": "Одна подія: слова мовця й окреме підтвердження",
                  "color": "slate",
                  "description": "У першому прикладі мовець не має спогаду, але запис окремо підтверджує надсилання. У другому сама забудькуватість спричинила пропуск до потрібного часу; запитання клієнта стало нагадуванням. Це різниця між «не пам’ятаю подію» й «не виконав потрібну дію», а не заміна однієї фрази іншою.",
                  "examples": [
                    {
                      "en": "I don’t remember sending the invoice, but the log shows I sent it yesterday.",
                      "ua": "Я не пам’ятаю, щоб надсилав рахунок, але журнал показує, що я надіслав його вчора."
                    },
                    {
                      "en": "I forgot to send the invoice before noon. The client’s question reminded me.",
                      "ua": "Я забув надіслати рахунок до полудня. Запитання клієнта нагадало мені про це."
                    },
                    {
                      "en": "Did you remember to send the invoice?",
                      "ua": "Ти не забув надіслати рахунок?"
                    }
                  ],
                  "note": "Питання в третьому прикладі не дає відповіді ні «так», ні «ні». Для точної оцінки потрібна відповідь або інший факт. Не домислюй надсилання чи його відсутності лише через запитання про пам’ять."
                }
              ]
            }
          }
        }
      ]
    },
