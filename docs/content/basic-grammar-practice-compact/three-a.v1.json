              {
                "lang": "en",
                "text": "She sleeps."
              }
            ]
          },
          {
            "index": 1,
            "source_item_sha256": "e104980cba1887075cf5898420ab75fbfd6e2019b354cd09a27990c4469b696c",
            "instruction_uk": "Що описує happy після is?",
            "stimuli": [
              {
                "lang": "en",
                "text": "She is happy."
              }
            ]
          }
        ],
        "inputs": [
          {
            "index": 0,
            "source_item_sha256": "bcc3167ddc8af05e4a14e640a650947ab1b125d966e685c02c77d0f558fd3fcf",
            "instruction_uk": "Збережи нейтральний порядок: виконавець, дія, додаток.",
            "stimuli": [
              {
                "lang": "uk",
                "text": "Марія любить музику."
              }
            ]
          },
          {
            "index": 1,
            "source_item_sha256": "21a55c361597e4758a6888e07f63fe01ebf54cc16d6f1d9e0e37f77925f1b407",
            "instruction_uk": "Почни з виконавця; заняття постав після дії.",
            "stimuli": [
              {
                "lang": "uk",
                "text": "Він грає в теніс."
              }
            ]
          },
          {
            "index": 2,
            "source_item_sha256": "3e60f32cbab104da87d4f852581284d10378fc6e27cc00d58650135bcd13f3ec",
            "instruction_uk": "Почни з уже названих студентів; збережи множину.",
            "stimuli": [
              {
                "lang": "uk",
                "text": "Студенти читають книги."
              }
            ]
          },
          {
            "index": 3,
            "source_item_sha256": "7cd9408d7bfd3b708514675ce3dd326dfa768f0561aabc506dbfa34c4d121591",
            "instruction_uk": "Почни з відомого кухаря; ужий простий теперішній час.",
            "stimuli": [
              {
                "lang": "uk",
                "text": "Кухар ріже помідори."
              }
            ]
          },
          {
            "index": 4,
            "source_item_sha256": "91262be8347096211bb27b10ac28756ccd236971f1f8045220b7b7a2bedc9195",
            "instruction_uk": "Лиса згадують уперше, фермера — ні; ужий простий теперішній час.",
            "stimuli": [
              {
                "lang": "uk",
                "text": "Молодий лис іде за фермером."
              }
            ]
          }
        ],
        "rephrase": [
          {
            "index": 0,
            "source_item_sha256": "cb21aa9a849d2470d3de1661bb12bd4a7dffe00846f1d1438ca357bbda694074",
            "instruction_uk": "Зразок: нейтральний порядок без акцентного винесення.",
