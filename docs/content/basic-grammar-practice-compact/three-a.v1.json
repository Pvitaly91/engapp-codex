            "stimuli": [
              {
                "lang": "en",
                "text": "She reads books."
              }
            ]
          },
          {
            "index": 2,
            "source_item_sha256": "f07ab782eb65d61f8e77079112e46b7484e98e70095febbf5983ddead6d6346c",
            "instruction_uk": "Визнач роль books.",
            "stimuli": [
              {
                "lang": "en",
                "text": "She reads books."
              }
            ]
          },
          {
            "index": 3,
            "source_item_sha256": "b69e24de8157f7a09b47a7d1a5c835bbf9b858ece59665a45587707a8b16f308",
            "instruction_uk": "Підмет не повторюй; додай дію та її предмет.",
            "stimuli": [
              {
                "lang": "uk",
                "text": "Малює портрети."
              },
              {
                "lang": "en",
                "text": "The artist ____."
              }
            ]
          },
          {
            "index": 4,
            "source_item_sha256": "b513472f92e836b06116be206c4270b261ad49b11b0de2e651e099c685fa3cde",
            "instruction_uk": "Після тварини постав дію, потім їжу.",
            "stimuli": [
              {
                "lang": "uk",
                "text": "Їсть моркву."
              },
              {
                "lang": "en",
                "text": "The rabbit ____."
              }
            ]
          }
        ],
        "choices": [
          {
            "index": 0,
            "source_item_sha256": "41820fd31408f911279b283eecba7a979cae8566c30637f3c1caab2cd66a3302",
            "instruction_uk": "Чи потрібен додаток для повноти цього речення?",
