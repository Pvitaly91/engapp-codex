      "items": {
        "selects": [
          {
            "index": 0,
            "source_item_sha256": "0979b80e69b94e5825590441df92a37f00f41128dd0fbd6ffe0e40b38b312ba2",
            "instruction_uk": "Визнач частину мови слова CAT.",
            "stimuli": [
              {
                "lang": "en",
                "text": "The CAT is sleeping."
              }
            ]
          },
          {
            "index": 1,
            "source_item_sha256": "b66c23926aed6997b14fd9c340ffe4c1d998a45780354b6c04954d5f8bc1a968",
            "instruction_uk": "Визнач частину мови слова QUICKLY.",
            "stimuli": [
              {
                "lang": "en",
                "text": "She QUICKLY finished her work."
              }
            ]
          },
          {
            "index": 2,
            "source_item_sha256": "1dbd5a4b0373f171c69544b48c3f6e20766ff58e055a3e3ed3f90a31ec30533c",
            "instruction_uk": "Визнач частину мови TO перед назвою місця.",
            "stimuli": [
              {
                "lang": "en",
                "text": "They went TO the park."
              }
            ]
          },
          {
            "index": 3,
            "source_item_sha256": "393c6302ddadc60c4b8e48c3b4dc3c4ff9d34c3a86167479da3b7ed36c9326dc",
            "instruction_uk": "Опиши вагу сумки прикметником.",
            "stimuli": [
              {
                "lang": "uk",
                "text": "Сумка важка."
              },
              {
                "lang": "en",
                "text": "The bag is ____."
              }
            ]
          },
          {
            "index": 4,
            "source_item_sha256": "70bde62cc875b6beeb125e11be60bdeece8b6cf7eec3b1f346d281f950e66d6a",
            "instruction_uk": "Передай спосіб читання.",
            "stimuli": [
              {
                "lang": "uk",
                "text": "Будь ласка, читай уважно."
              },
              {
                "lang": "en",
                "text": "Please read ____."
              }
            ]
          }
        ],
        "choices": [
          {
            "index": 0,
            "source_item_sha256": "07328c1ac7403ebeae07387b0bc921210638329e0f68b802c6918c5ed4f37861",
            "instruction_uk": "Зістав частини мови FAST у двох реченнях.",
            "stimuli": [
              {
                "lang": "en",
                "text": "The train is FAST. The train moves FAST."
              }
            ]
          },
          {
            "index": 1,
            "source_item_sha256": "318a6e4eb7a9be00e16a61271754410d1d040f85510a32ea3b7e00e928132e2c",
            "instruction_uk": "Поясни роль IT; раніше жодного предмета не названо.",
            "stimuli": [
              {
                "lang": "en",
                "text": "It is cold today."
              }
            ]
          }
        ],
        "inputs": [
          {
            "index": 0,
            "source_item_sha256": "0242bfa4e1c5d45b8ce6fda2f560cfc34d00d8d6c066bd9c4adf83d2d37028b3",
            "instruction_uk": "Обери beautiful або beautifully; введи одне слово.",
            "stimuli": [
              {
                "lang": "uk",
                "text": "Вона гарно співає."
              },
              {
                "lang": "en",
                "text": "She sings ___."
              }
            ]
          },
          {
            "index": 1,
            "source_item_sha256": "a77e28f1f9dde69a0e71104db3b30fa37df3992264d2e2042a38ec5d9c918051",
            "instruction_uk": "Обери good або well для ознаки учня, не здоров’я.",
            "stimuli": [
              {
                "lang": "uk",
                "text": "Він хороший учень."
              },
              {
                "lang": "en",
                "text": "He is a ___ student."
              }
            ]
          },
          {
            "index": 2,
            "source_item_sha256": "5e72eb5fd464502ef8cf6329e4c82510b70ad0ab76870a0300ec1d1833eec0aa",
            "instruction_uk": "Обери hard або hardly для наполегливої праці.",
            "stimuli": [
              {
                "lang": "uk",
                "text": "Вони наполегливо працюють щодня."
              },
              {
                "lang": "en",
                "text": "They work ___ every day."
              }
            ]
          },
          {
            "index": 3,
            "source_item_sha256": "f25a605501fa670cc74d3fa76f5320d0cf3f389a9cb7bd383bdc9956eca7c7fb",
            "instruction_uk": "Пташку згадують уперше; спосіб співу постав у кінці.",
            "stimuli": [
              {
                "lang": "uk",
                "text": "Маленька пташка голосно співає."
              }
            ]
          },
          {
            "index": 4,
            "source_item_sha256": "1f1ee1d7e1018c1edfd820f7390f8b003c367d25d767637ead9f050d75301337",
            "instruction_uk": "Почни з Олі, потім мовця; сад уже відомий.",
            "stimuli": [
              {
                "lang": "uk",
                "text": "Оля і я перебуваємо в саду."
              }
            ]
          },
          {
            "index": 5,
            "source_item_sha256": "a9b1c2d6e34b1d9ff457cb04e79d5f924750088aa2986444eaa37daa4da5bc1f",
            "instruction_uk": "Почни з відомого пекаря; використай простий теперішній час.",
            "stimuli": [
              {
                "lang": "uk",
                "text": "Молодий пекар усміхається."
              }
            ]
          },
          {
            "index": 6,
            "source_item_sha256": "04a5144effd4837b8c58618be031abcc52098459404e27879d0f89c71f491fe7",
            "instruction_uk": "Передай звичне мовлення простим теперішнім часом; спосіб постав після дієслова.",
            "stimuli": [
              {
                "lang": "uk",
                "text": "Моя тітка говорить тихо."
              }
            ]
          }
        ],
        "rephrase": [
          {
            "index": 0,
            "source_item_sha256": "4d9d7e597cb9f0c7f8e7873f09a57b4e7441be7543f31fba460430a03cd592bf",
            "instruction_uk": "Зразок: назви частини мови за порядком слів.",
            "stimuli": [
              {
                "lang": "en",
                "text": "The happy dog runs quickly."
              },
              {
                "lang": "en",
              "text": "→ article, adjective, noun, verb, adverb"
              }
            ]
          },
          {
            "index": 1,
            "source_item_sha256": "e718aeb1b9fed77c16b83b5b008a018e772f6570aa6f42d06d0f9d542886f29b",
            "instruction_uk": "Назви частини мови всіх семи слів у початковому порядку.",
            "stimuli": [
              {
                "lang": "en",
                "text": "She and I went to school yesterday."
              }
            ]
          },
          {
            "index": 2,
            "source_item_sha256": "435cae6db180d885f2f795d97ef2a3b1f5ee883a0abd096d598aa0b105a02f2e",
            "instruction_uk": "Назви частини мови десяти слів; допоміжне й основне дієслова обліковуй окремо.",
            "stimuli": [
              {
                "lang": "en",
                "text": "Wow! The big cat is sleeping on the soft bed."
              }
            ]
          }
        ]
      }
    },
