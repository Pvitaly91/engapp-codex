        },
        {
            "id": 11706,
            "question_id": 23725,
            "provider": "compose_prompt",
            "locale": "en",
            "hint": "Use the past perfect simple for a state. Start with the main-clause subject; do not move time or reason phrases to the front. Describe a belief that lasted until contradictory original figures appeared; use a state form.",
            "created_at": "2026-10-04T22:49:11.000000Z",
            "updated_at": "2026-10-04T22:49:11.000000Z"
        },
        {
            "id": 11707,
            "question_id": 23725,
            "provider": "chatgpt",
            "locale": "en",
            "hint": "Lexical verb: believe. This is a state lasting up to a past point, not an activity: use the past perfect simple, without an -ing form.",
            "created_at": "2026-10-04T22:49:11.000000Z",
            "updated_at": "2026-10-04T22:49:11.000000Z"
        },
        {
