        {
            "id": 13745,
            "question_id": 23957,
            "provider": "chatgpt",
            "locale": "uk",
            "hint": "Лексична основа: stretch — розширювати межі. Названа дата або подія задає початок, а не кількість часу. Зв’яжи її з процесом, який тривав до минулого моменту.",
            "created_at": "2026-10-04T22:50:28.000000Z",
            "updated_at": "2026-10-04T22:50:28.000000Z"
        },
        {
            "id": 13746,
            "question_id": 23957,
            "provider": "compose_prompt",
            "locale": "en",
            "hint": "Use the past perfect continuous for the earlier process. Preserve the order of the semantic parts; keep the opening time, concession or topic phrase first. Put the initiating exception first and emphasise an uninterrupted tendency from then onwards.",
            "created_at": "2026-10-04T22:50:28.000000Z",
            "updated_at": "2026-10-04T22:50:28.000000Z"
        },
        {
            "id": 13747,
            "question_id": 23957,
            "provider": "chatgpt",
