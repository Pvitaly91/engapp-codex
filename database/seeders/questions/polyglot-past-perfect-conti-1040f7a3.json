            "updated_at": "2026-10-04T22:51:05.000000Z"
        },
        {
            "id": 13920,
            "question_id": 16856,
            "provider": "compose_prompt",
            "locale": "en",
            "hint": "Use the past perfect continuous for the earlier process. Start with the main-clause subject; do not move time or reason phrases to the front. Reject sadness as the motive for earlier crying without denying tears.",
            "created_at": "2026-10-04T22:51:05.000000Z",
            "updated_at": "2026-10-04T22:51:05.000000Z"
        },
        {
            "id": 13921,
            "question_id": 16856,
            "provider": "polyglot-v3",
            "locale": "en",
            "hint": "Lexical verb: cry. Describe the process leading up to a past point, not merely a finished result. Preserve the stated cause, contrast or time relation.",
            "created_at": "2026-10-04T22:51:05.000000Z",
            "updated_at": "2026-10-04T22:51:05.000000Z"
        },
        {
