            "updated_at": "2026-10-04T22:51:05.000000Z"
        },
        {
            "id": 13975,
            "question_id": 16867,
            "provider": "compose_prompt",
            "locale": "en",
            "hint": "Use the past perfect continuous for the earlier process. Start with the question phrase or auxiliary; keep other circumstances after the verb group. Ask whether the material read was a summary rather than the full report.",
