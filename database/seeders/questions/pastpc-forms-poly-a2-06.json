        },
        {
            "id": 11532,
            "question_id": 23696,
            "provider": "compose_prompt",
            "locale": "en",
            "hint": "Use the past perfect continuous for the earlier process. Start with the main-clause subject; do not move time or reason phrases to the front. Describe a baby girl's crying before her mother lifted her.",
            "created_at": "2026-10-04T22:49:10.000000Z",
            "updated_at": "2026-10-04T22:49:10.000000Z"
        },
        {
