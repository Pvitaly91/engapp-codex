            "updated_at": "2026-10-04T22:49:11.000000Z"
        },
        {
            "id": 11772,
            "question_id": 23736,
            "provider": "compose_prompt",
            "locale": "en",
            "hint": "Use the past perfect continuous for the earlier process. Start with the main-clause subject; do not move time or reason phrases to the front. Contrast prior understanding of a rule with a sustained error in its application.",
            "created_at": "2026-10-04T22:49:11.000000Z",
            "updated_at": "2026-10-04T22:49:11.000000Z"
        },
        {
            "id": 11773,
