        {
            "id": 13380,
            "question_id": 23896,
            "provider": "compose_prompt",
            "locale": "en",
            "hint": "Use the past perfect continuous for the earlier process. Start with the main-clause subject; do not move time or reason phrases to the front. Describe work beginning in the morning and continuing up to dinner.",
            "created_at": "2026-10-04T22:50:23.000000Z",
            "updated_at": "2026-10-04T22:50:23.000000Z"
        },
        {
            "id": 13381,
