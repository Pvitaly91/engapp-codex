            "id": 11809,
            "question_id": 23742,
            "provider": "chatgpt",
            "locale": "en",
            "hint": "Lexical verb: deteriorate. Describe the process leading up to a past point, not merely a finished result. Preserve the stated cause, contrast or time relation.",
            "created_at": "2026-10-04T22:49:12.000000Z",
            "updated_at": "2026-10-04T22:49:12.000000Z"
        },
