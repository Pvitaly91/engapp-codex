        },
        {
            "id": 11807,
            "question_id": 23742,
            "provider": "chatgpt",
            "locale": "uk",
            "hint": "Лексична основа: deteriorate — погіршуватися. Умова описує процес до минулого моменту, а не лише завершений результат. Збережи причину, протиставлення або часовий зв’язок, названі в умові.",
            "created_at": "2026-10-04T22:49:12.000000Z",
            "updated_at": "2026-10-04T22:49:12.000000Z"
        },
        {
            "id": 11808,
            "question_id": 23742,
            "provider": "compose_prompt",
            "locale": "en",
            "hint": "Use the past perfect continuous for the earlier process. Preserve the order of the semantic parts; keep the opening time, concession or topic phrase first. Contrast a completed reduction in symptoms with an earlier continuing decline in other respects.",
            "created_at": "2026-10-04T22:49:12.000000Z",
            "updated_at": "2026-10-04T22:49:12.000000Z"
        },
