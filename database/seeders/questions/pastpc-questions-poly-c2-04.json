        },
        {
            "id": 13104,
            "question_id": 23886,
            "provider": "compose_prompt",
            "locale": "en",
            "hint": "Use the past perfect continuous for the earlier process. Start with the question phrase or auxiliary; keep other circumstances after the verb group. Ask for the agent of earlier narrative shaping, not its audience.",
            "created_at": "2026-10-04T22:49:59.000000Z",
            "updated_at": "2026-10-04T22:49:59.000000Z"
        },
        {
            "id": 13105,
            "question_id": 23886,
            "provider": "chatgpt",
            "locale": "en",
            "hint": "Lexical verb: shape. The question word itself is the subject. Do not add another subject or auxiliary do.",
            "created_at": "2026-10-04T22:49:59.000000Z",
            "updated_at": "2026-10-04T22:49:59.000000Z"
        },
        {
