            "updated_at": "2026-10-04T22:51:05.000000Z"
        },
        {
            "id": 13836,
            "question_id": 16839,
            "provider": "polyglot-v3",
            "locale": "en",
            "hint": "Lexical verb: read. Describe the process leading up to a past point, not merely a finished result. Preserve the stated cause, contrast or time relation.",
            "created_at": "2026-10-04T22:51:05.000000Z",
            "updated_at": "2026-10-04T22:51:05.000000Z"
        },
        {
