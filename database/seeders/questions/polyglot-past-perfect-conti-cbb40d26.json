            "updated_at": "2026-10-04T22:51:05.000000Z"
        },
        {
            "id": 13835,
            "question_id": 16839,
            "provider": "compose_prompt",
            "locale": "en",
            "hint": "Use the past perfect continuous for the earlier process. Start with the main-clause subject; do not move time or reason phrases to the front. Contrast an ongoing reading process with an incomplete separate check.",
