            "updated_at": "2026-10-04T22:51:05.000000Z"
        },
        {
            "id": 13980,
            "question_id": 16868,
            "provider": "compose_prompt",
            "locale": "en",
            "hint": "Use the past perfect continuous for the earlier process. Start with the question phrase or auxiliary; keep other circumstances after the verb group. Ask whether her earlier wait for us took place at the incorrect entrance.",
            "created_at": "2026-10-04T22:51:06.000000Z",
            "updated_at": "2026-10-04T22:51:06.000000Z"
        },
        {
            "id": 13981,
            "question_id": 16868,
            "provider": "polyglot-v3",
            "locale": "en",
            "hint": "Lexical verb: wait. In a direct question the auxiliary precedes the subject, with the question phrase first. Preserve the relation to the later past event.",
            "created_at": "2026-10-04T22:51:06.000000Z",
            "updated_at": "2026-10-04T22:51:06.000000Z"
        },
