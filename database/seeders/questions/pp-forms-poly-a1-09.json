    "chatgpt_explanations": [
        {
            "id": 36251,
            "question": "Бен був утомлений, бо попередньої ночі погано спав.",
            "wrong_answer": "after",
            "correct_answer": "had",
            "language": "ua",
            "explanation": "\"After\" є сполучником/прийменником і не може утворювати час Past Perfect. Тут потрібно допоміжне дієслово had, щоб передати попередню дію: \"He was calm because he had prepared the message.\"",
            "created_at": "2026-06-16T10:34:17.000000Z",
            "updated_at": "2026-07-19T23:05:25.000000Z"
        },
        {
            "id": 36253,
            "question": "Бен був утомлений, бо попередньої ночі погано спав.",
            "wrong_answer": "because",
            "correct_answer": "He",
            "language": "ua",
            "explanation": "Слово \"because\" перекладає сполучник \"бо\", а не займенник \"Він\". На початку речення потрібен підмет \"He\", що відповідає \"Він\".",
            "created_at": "2026-06-16T10:34:19.000000Z",
            "updated_at": "2026-07-19T23:05:25.000000Z"
        },
        {
            "id": 36246,
            "question": "Бен був утомлений, бо попередньої ночі погано спав.",
            "wrong_answer": "before",
            "correct_answer": "because",
            "language": "ua",
            "explanation": "«Бо» вказує на причину спокою, тож потрібен сполучник because. Before означає «перед тим як», виражає час, а не причину, і спотворює зміст речення.",
            "created_at": "2026-06-16T10:34:09.000000Z",
            "updated_at": "2026-07-19T23:05:25.000000Z"
        },
        {
            "id": 36245,
            "question": "Бен був утомлений, бо попередньої ночі погано спав.",
            "wrong_answer": "by",
            "correct_answer": "calm",
            "language": "ua",
            "explanation": "\"by\" — це прийменник («біля», «за допомогою») і не передає значення «спокійний». У реченні потрібен прикметник, тож правильне слово — calm.",
            "created_at": "2026-06-16T10:34:09.000000Z",
            "updated_at": "2026-07-19T23:05:25.000000Z"
        },
        {
            "id": 36255,
            "question": "Бен був утомлений, бо попередньої ночі погано спав.",
            "wrong_answer": "by",
            "correct_answer": "had",
            "language": "ua",
            "explanation": "\"By\" — це прийменник, а не допоміжне дієслово, тож він не утворює час Past Perfect і граматично не підходить у значенні \"бо підготував\". Тут потрібно had: He was calm because he had prepared the message.",
            "created_at": "2026-06-16T10:34:21.000000Z",
            "updated_at": "2026-07-19T23:05:25.000000Z"
        },
        {
            "id": 36247,
            "question": "Бен був утомлений, бо попередньої ночі погано спав.",
            "wrong_answer": "had",
            "correct_answer": "calm",
            "language": "ua",
            "explanation": "Слово had — це дієслово (минулий час від have) і не означає “спокійний”; у цьому місці потрібен прикметник для опису стану. Правильне слово calm передає значення “спокійний”.",
            "created_at": "2026-06-16T10:34:09.000000Z",
            "updated_at": "2026-07-19T23:05:25.000000Z"
        },
        {
            "id": 36249,
            "question": "Бен був утомлений, бо попередньої ночі погано спав.",
            "wrong_answer": "has",
            "correct_answer": "because",
            "language": "ua",
            "explanation": "\"Has\" — це допоміжне дієслово (Present Perfect), а не сполучник, тож воно не може виражати причину й поєднувати частини речення. Тут потрібен сполучник причини — \"because\".",
            "created_at": "2026-06-16T10:34:10.000000Z",
            "updated_at": "2026-07-19T23:05:25.000000Z"
        },
        {
            "id": 36250,
            "question": "Бен був утомлений, бо попередньої ночі погано спав.",
            "wrong_answer": "has",
            "correct_answer": "was",
            "language": "ua",
            "explanation": "\"Has\" — це теперішній час дієслова \"to have\" («має») і не може бути зв’язкою з прикметником \"calm\". Потрібне дієслово-зв’язка в минулому часі для \"він був спокійний\" — тобто \"was\".",
            "created_at": "2026-06-16T10:34:10.000000Z",
            "updated_at": "2026-07-19T23:05:25.000000Z"
        },
        {
            "id": 36248,
            "question": "Бен був утомлений, бо попередньої ночі погано спав.",
            "wrong_answer": "have",
            "correct_answer": "was",
            "language": "ua",
            "explanation": "Неправильно, бо тут описують стан у минулому, тож потрібно дієслово to be в Past Simple — was. \"Have\" означає «мати» і в 3-й особі однини в теперішньому часі було б \"has\", тож воно не підходить ні за значенням, ні за часом.",
            "created_at": "2026-06-16T10:34:10.000000Z",
            "updated_at": "2026-07-19T23:05:25.000000Z"
        },
        {
            "id": 36252,
            "question": "Бен був утомлений, бо попередньої ночі погано спав.",
            "wrong_answer": "time",
            "correct_answer": "prepared",
            "language": "ua",
            "explanation": "Слово \"time\" означає «час» і є іменником, тоді як у реченні потрібне дієслово зі значенням «підготував». Тому \"time\" граматично й за змістом не підходить.",
            "created_at": "2026-06-16T10:34:18.000000Z",
            "updated_at": "2026-07-19T23:05:25.000000Z"
        }
    ]
}
