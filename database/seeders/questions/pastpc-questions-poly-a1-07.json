            "provider": "compose_prompt",
            "locale": "en",
            "hint": "Use the past perfect continuous for the earlier process. Start with the question phrase or auxiliary; keep other circumstances after the verb group. Ask whether Maria's activity before class involved making notes.",
            "created_at": "2026-10-04T22:49:58.000000Z",
            "updated_at": "2026-10-04T22:49:58.000000Z"
        },
