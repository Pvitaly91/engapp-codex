            "updated_at": "2026-10-04T22:50:25.000000Z"
        },
        {
            "id": 13603,
            "question_id": 23933,
            "provider": "chatgpt",
            "locale": "en",
            "hint": "Lexical verb: use. Preserve the time relation: a measured length, starting point, endpoint, whole period or duration accumulated at the named past point.",
            "created_at": "2026-10-04T22:50:25.000000Z",
            "updated_at": "2026-10-04T22:50:25.000000Z"
        },
        {
